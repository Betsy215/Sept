    var u = tt / 0.38f; pos = P + new Vector2(0f, 300f * (1f - outCubic(u))); alpha = c01(tt / 0.12f);
    rot = baseRot + 9f * Mathf.Exp(-5.5f * tt) * Mathf.Cos(2f * Mathf.PI * 2.2f * tt) * (tt < 0.9f ? 1f : 0f);
    var v = (tt - 0.34f) / 0.18f; tapeA = c01(v * 3f); tapeS = Mathf.Lerp(1.22f, 1f, outCubic(v)); tapeDark = Mathf.Lerp(1f, 0.9f, c01(v));
} else if (style == "b") {   // the tape first, then the paper unrolls from under it like being smoothed down
    var v = tt / 0.15f; tapeA = c01(v * 2f); tapeS = Mathf.Lerp(1.15f, 1f, outCubic(v)); tapeDark = Mathf.Lerp(1f, 0.92f, c01(v));
    var u = (tt - 0.1f) / 0.5f; var e = outCubic(u); clipH = (bH + 40f) * e;
