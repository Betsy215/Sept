var parts = n2.name.Split('|'); var P = new Vector2(float.Parse(parts[1], System.Globalization.CultureInfo.InvariantCulture), float.Parse(parts[2], System.Globalization.CultureInfo.InvariantCulture));
float bH = innerT.sizeDelta.y; const float baseRot = -1.2f;
System.Func<float, float> c01 = v => Mathf.Clamp01(v);
System.Func<float, float> outCubic = u => 1f - Mathf.Pow(1f - c01(u), 3f);
System.Func<float, float> outBack = u => { u = c01(u); const float k = 1.70158f; var x = u - 1f; return 1f + (k + 1f) * x * x * x + k * x * x; };
Vector2 pos = P; float rot = baseRot; Vector3 scl = Vector3.one; float alpha = 1f; float tapeS = 1f, tapeA = 1f, tapeDark = 0.92f; float clipH = bH; float crease = 0f; bool rollOn = false; float rollY = 0f, rollS = 1f, rollA = 1f;
var tt = T;
