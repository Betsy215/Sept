*.pdb.meta
*.mdb.meta
Assets/Plugins/Editor/JetBrains*

# Crash / import logs
sysinfo.txt
crashlytics-build.properties
**/*AssetImportWorker*.log
**/shadercompiler-AssetImportWorker*.log
mono_crash.*

# Build outputs
*.apk
*.aab
*.unitypackage
*.app
*.ipa
*_BurstDebugInformation_DoNotShip/

# Large source files
*.psd

# Unity Plastic SCM / Collab
.plastic/
ignore.conf

# macOS
.DS_Store

# VS Code workspace files (Unity regenerates them per folder name)
*.code-workspace

# MCP for Unity screenshot output
Captures/
Captures.meta
