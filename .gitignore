IOS_Build/
*.xcodeproj/
*.xcworkspace/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / solution files (regenerated by Unity)
.idea/
.vs/
.consulo/
ExportedObj/
